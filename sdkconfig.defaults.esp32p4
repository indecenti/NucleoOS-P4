# NucleoOS Anima — ESP32-P4 target: 32MB PSRAM @200MHz
# (P4 PSRAM type/mode is auto-detected by the ROM; no OCT/TYPE symbols like S3.)
CONFIG_SPIRAM=y

# nv_web serves the whole web OS: give LWIP enough sockets for the browser's parallel boot fetches
# (httpd max_open_sockets=8 + Wi-Fi/mDNS/SNTP/KeyDeck headroom) + Second Screen listeners
# (NucleoCast http/https + session, VNC viewer + reverse listener) + the nv_mqtt client (Home Assistant).
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- Wi-Fi via ESP32-C6 over esp-hosted (SDIO) ---
# The C6 is wired to the P4 exactly like the ESP32-P4-Function-EV-Board, so its preset
# owns the SDIO pinout: CLK18 CMD19 D0-3=14-17, Slave_Reset GPIO54 (active-high), slot 1.
# The C6 module ships pre-flashed with the esp-hosted-mcu slave firmware.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_USE_MEMPOOL=n
# Transport buffers (SDIO RX stream + every TX packet) from DMA-capable PSRAM, internal RAM only
# as fallback. Without it each packet allocates internal SRAM, and when that runs dry
# sdio_rx_get_buffer() hits assert(*buf) and reboots the OS (seen under audio+OTA load). The SDMMC
# DMA reads PSRAM directly at the same 64 B cache-line alignment, as the SD card path already does.
# nv_wifi.cpp refuses to build without it.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

# --- CPU: 360 MHz. 400 MHz crash-loops this board with an assert in clk.c:141 at boot
# (MSPI/PSRAM-200MHz clock derivation). Keep 360 — the validated freq for this JD9165+PSRAM combo.

# --- Camera: esp_cam_sensor's MIPI-CSI sensor drivers ---
# Both off: this board's 2MP module is an OV02C10 (chip id 0x5602), which
# nv_camera drives directly (esp_cam_sensor has no driver for it). Saves ~25 KB of flash.
# CONFIG_CAMERA_OV5647 is not set
# CONFIG_CAMERA_SC2336 is not set

# --- Display rotation ---
# PPA-accelerated rotation for esp_lvgl_port sw_rotate (portrait mode). Without this the
# port falls back to lv_draw_sw_rotate on the CPU for every flushed region.
CONFIG_LVGL_PORT_ENABLE_PPA=y

# --- esp_audio_codec: trim to the music-player decoder set (nv_media) ---
# We only DECODE for playback; every encoder is dead flash. Keep MP3/AAC/FLAC + WAV/M4A/PCM;
# drop telephony/niche codecs. All are #ifdef-guarded in register_default, so disabling just
# unregisters them.
CONFIG_AUDIO_ENCODER_AAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_G711_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_ENCODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_ENCODER_OPUS_SUPPORT=n
CONFIG_AUDIO_ENCODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_ALAC_SUPPORT=n
CONFIG_AUDIO_ENCODER_PCM_SUPPORT=n
CONFIG_AUDIO_ENCODER_SBC_SUPPORT=n
CONFIG_AUDIO_ENCODER_LC3_SUPPORT=n
CONFIG_AUDIO_ENCODER_G722_SUPPORT=n
CONFIG_AUDIO_DECODER_G711_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRNB_SUPPORT=n
CONFIG_AUDIO_DECODER_AMRWB_SUPPORT=n
CONFIG_AUDIO_DECODER_OPUS_SUPPORT=n
CONFIG_AUDIO_DECODER_VORBIS_SUPPORT=n
CONFIG_AUDIO_DECODER_ADPCM_SUPPORT=n
CONFIG_AUDIO_DECODER_ALAC_SUPPORT=n
CONFIG_AUDIO_DECODER_SBC_SUPPORT=n
CONFIG_AUDIO_DECODER_LC3_SUPPORT=n
CONFIG_AUDIO_DECODER_G722_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=n
CONFIG_AUDIO_SIMPLE_DEC_OGG_SUPPORT=n

# --- esp_h264 SW decoder: squeeze the P4 dual-core for video playback ---
# Decode across BOTH RISC-V cores (~2x throughput) with hot code in IRAM. The P4-optimized asm
# libs (sw/libs/esp32p4) are selected automatically by target.
CONFIG_ESP_H264_DUAL_TASK=y

# --- Free internal SRAM: put Wi-Fi/lwIP buffers in PSRAM first ---
# Internal SRAM runs ~30 KB largest-contiguous with the stack up; keeping network buffers in
# PSRAM leaves internal room for DMA + task TCBs (task stacks are moved to PSRAM in code).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# nv_web /ws live socket; the pre-handshake hook refuses unpaired clients before the upgrade
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y

# Second Screen wizard: QR code of the connection address (LVGL's bundled qrcodegen).
CONFIG_LV_USE_QRCODE=y

# --- Bluetooth LE (NimBLE host over esp_hosted VHCI) ---
# Game controllers (nv_bt, HID over GATT). The P4 has no radio: the C6 runs the BLE controller and
# HCI rides the esp_hosted SDIO link next to Wi-Fi, so only the NimBLE *host* is built here.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# NimBLE pools/buffers in PSRAM (internal SRAM famine killed esp_hosted before). The host task
# stack stays internal (it writes bonds to NVS); 5 KB for the HID setup + nv_pad calls.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
# We are only ever the central: no advertising, no GATT server (and so no GATT services).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# CONFIG_BT_NIMBLE_ROLE_PERIPHERAL is not set
# CONFIG_BT_NIMBLE_ROLE_BROADCASTER is not set
CONFIG_BT_NIMBLE_GATT_CLIENT=y
# CONFIG_BT_NIMBLE_GATT_SERVER is not set
# Legacy (4.x) scan/connect only: pads advertise legacy PDUs; saves flash.
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT is not set
# Pairing: Just Works + LE Secure Connections (legacy pairing kept for older pads), bonds in NVS.
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=6
# Modest buffer counts (all in PSRAM).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_ACL_FROM_LL_COUNT=16
CONFIG_BT_NIMBLE_TRANSPORT_EVT_COUNT=20
CONFIG_BT_NIMBLE_TRANSPORT_EVT_DISCARD_COUNT=8
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# CONFIG_BT_NIMBLE_DEBUG is not set
