+#include "sdkconfig.h"
+#if CONFIG_IDF_TARGET_ESP32P4
+/* ESP32-P4 (NucleoV2-local): with CONFIG_ESP_SYSTEM_PMP_IDRAM_SPLIT no heap region carries
+ * MALLOC_CAP_EXEC, but PSRAM is instruction-fetchable (the PMA entry over the cached range is RWX
+ * and no PMP entry restricts it for M-mode), so AOT text lives there instead of scarce internal
+ * SRAM. Each block is cache-line aligned at both ends, so os_icache_flush() can write back and
+ * invalidate exactly its own lines without discarding a neighbour's dirty data. */
+#include "esp_heap_caps.h"
+#include "esp_cache.h"
+#include "esp_memory_utils.h"
+
+#define P4_EXEC_LINE 128 /* >= every L1/L2 line size the P4 can be configured with */
+
+static void *
+p4_exec_alloc(size_t size)
+{
+    size_t body = (size + P4_EXEC_LINE - 1) & ~(size_t)(P4_EXEC_LINE - 1);
+    /* One leading line holds the origin pointer that os_munmap() -> os_free() reads back. */
+    uint8_t *origin = heap_caps_aligned_alloc(P4_EXEC_LINE, P4_EXEC_LINE + body,
+                                              MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (!origin) {
+        return NULL;
+    }
+    uint8_t *fixed = origin + P4_EXEC_LINE;
+    ((uintptr_t *)fixed)[-1] = (uintptr_t)origin;
+    memset(fixed, 0, body);
+    return fixed;
+}
+#endif
+
+#if CONFIG_IDF_TARGET_ESP32P4
+static void *s_handoff;
+static size_t s_handoff_size;
+
+/* NucleoV2: hand the next non-executable os_mmap (a linear memory) a block allocated by the
+   embedder (heap_caps_*; freed through os_munmap -> os_free like any other). Returns the block
+   still pending, if any, so the caller can free what WAMR did not take. */
+void *
+os_mmap_set_handoff(void *block, size_t size)
+{
+    void *prev = s_handoff;
+    s_handoff = block;
+    s_handoff_size = block ? size : 0;
+    return prev;
+}
+#endif
+
 void *
 os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
 {
+#if CONFIG_IDF_TARGET_ESP32P4
+    if (prot & MMAP_PROT_EXEC) {
+        return p4_exec_alloc(size);
+    }
+#endif
     if (prot & MMAP_PROT_EXEC) {
 #if (WASM_MEM_DUAL_BUS_MIRROR != 0)
         uint32_t mem_caps = MALLOC_CAP_SPIRAM;
@@ -56,8 +108,21 @@ os_mmap(void *hint, size_t size, int prot, int flags, os_file_handle file)
 #else
         uint32_t mem_caps = MALLOC_CAP_8BIT;
 #endif
-        void *buf_origin =
-            heap_caps_malloc(size + 4 + sizeof(uintptr_t), mem_caps);
+        void *buf_origin = NULL;
+#if CONFIG_IDF_TARGET_ESP32P4
+        /* NucleoV2: a block the embedder set aside for this run's linear memory (see
+           os_mmap_set_handoff) is used as is: the memory then never has to find a
+           fresh contiguous block in a fragmented PSRAM. */
+        if (s_handoff && size + 4 + sizeof(uintptr_t) <= s_handoff_size
+            && size >= s_handoff_size / 2) { /* the big one: never a small side map */
+            buf_origin = s_handoff;
+            s_handoff = NULL;
+            s_handoff_size = 0;
+        }
+#endif
+        if (!buf_origin) {
+            buf_origin = heap_caps_malloc(size + 4 + sizeof(uintptr_t), mem_caps);
+        }
         if (!buf_origin) {
             return NULL;
         }
