 /* Exec protected: exec function and capture any exception and contain it within call */
 /* Exceptions or fatal errors are not propagated */
+#ifdef NV_WASI
+/* noinline + `jmp` on the shadow stack: this function's epilogue must restore __stack_pointer,
+ * which the host's unwind does not rewind (see nv_sjlj.h) */
+__attribute__((noinline))
+#endif
 int be_execprotected(bvm *vm, bpfunc f, void *data)
 {
     struct blongjmp jmp;
     jmp.status = 0;
     jmp.prev = vm->errjmp; /* save long jump position */
     vm->errjmp = &jmp;
+#ifdef NV_WASI
+    {
+        struct nv_pcall c = { f, vm, data };
+        jmp.b = be_nv_newid();
+        if (nv_try_call(nv_pcall_tramp, &c) != 0 && be_nv_target != jmp.b) {
+            nv_throw(); /* aimed at an outer region: keep unwinding */
+        }
+    }
+#else
     exec_try(vm->errjmp) {
         f(vm, data);
     }
+#endif
     vm->errjmp = jmp.prev; /* restore long jump position */
     return jmp.status;
 }
