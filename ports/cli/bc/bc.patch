+		sig_atomic_t status = vm->status;
+		vm->status = BC_STATUS_SUCCESS;
+		bc_parse_reset(&vm->prs);
+		vm->status = status;
+	}
+	nv_in_parse = false;
+
+	if (mode == BC_MODE_STDIN && BC_I && vm->status != BC_STATUS_QUIT)
+	{
+		bc_vm_clean();
+		vm->status = BC_STATUS_SUCCESS;
+		vm->sig_pop = 0;
+		vm->sig = 0;
+		vm->sig_lock = 0;
+		return;
+	}
+
+	vm->sig_lock = 0;
+	nv_throw();
+}
