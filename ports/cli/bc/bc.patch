+ * label: an interactive stdin line recovers, anything else keeps unwinding to main().
+ * noinline + `a` on the shadow stack: the epilogue restores __stack_pointer after an unwind.
+ */
+__attribute__((noinline)) static void
 bc_vm_process(const char* text, BcMode mode)
 {
+	struct nv_process_args a = { text, mode };
+	size_t len = vm->jmp_bufs.len;
+	const char* file = vm->file;
+	uchar vmode = vm->mode;
+
+	nv_in_parse = false;
+	if (nv_try_call(nv_process_tramp, &a) == 0) return;
