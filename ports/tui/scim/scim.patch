+    } else if (x->f.n && ! x->fshared && get_conf_int("xlsx_readformulas")) {
+        cell_formula(r, c, xbuf_str(&x->f));                  /* a formula, if wanted */
+    } else if (! strcmp(t, "str") || ! strcmp(t, "e")) {      /* text result, error value */
+        cell_label(r, c, v);
+    } else if (! strcmp(t, "b")) {                            /* boolean */
+        if (x->v.n) {
+            swprintf(line_interp, FBUFLEN, L"let %s%d=%d", coltoa(c), r, atoi(v) ? 1 : 0);
+            send_to_interp(line_interp);
