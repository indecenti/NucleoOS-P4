+typedef struct { char * p; size_t n, cap; } xbuf;
+
+static void xbuf_add(xbuf * b, const char * s, size_t n) {
+    if (b->n + n + 1 > b->cap) {
+        size_t cap = b->cap ? b->cap : 64;
+        while (cap < b->n + n + 1) cap *= 2;
+        char * p = realloc(b->p, cap);
+        if (p == NULL) return;                 /* out of memory: the text is cut, not crashed */
+        b->p = p;
+        b->cap = cap;
+    }
+    memcpy(b->p + b->n, s, n);
+    b->n += n;
+    b->p[b->n] = '\0';
+}
+static void xbuf_clear(xbuf * b) { b->n = 0; if (b->p) b->p[0] = '\0'; }
+static const char * xbuf_str(xbuf * b) { return b->p ? b->p : ""; }
+
+/* An attribute of a SAX2 element (local name), copied into out ("" when absent). */
+static void xattr(const xmlChar ** attrs, int n, const char * name, char * out, size_t outn) {
+    out[0] = '\0';
+    for (int i = 0; i < n; i++) {
+        if (strcmp((const char *) attrs[i * 5], name)) continue;
+        size_t len = (size_t) (attrs[i * 5 + 4] - attrs[i * 5 + 3]);
+        if (len >= outn) len = outn - 1;
+        memcpy(out, attrs[i * 5 + 3], len);
+        out[len] = '\0';
+        return;
+    }
+}
