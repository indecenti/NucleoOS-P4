+/* What a cell's number format makes of its value. */
+enum { XK_NUMBER, XK_DATE, XK_TIME, XK_DATETIME };
+
+static int xlsx_kind(const xstyles * st, int style) {
+    if (style < 0 || style >= st->nxf) return XK_NUMBER;
+    int id = st->xf[style];
+    if (id >= 14 && id <= 17) return XK_DATE;
+    if ((id >= 18 && id <= 21) || (id >= 45 && id <= 47)) return XK_TIME;
+    if (id == 22) return XK_DATETIME;
+    if (id < 164) return XK_NUMBER;
+    /* a custom format: dates have d or y, times h or s, outside quotes and [..] */
+    const char * code = NULL;
+    for (int i = 0; i < st->nfmt; i++) if (st->fmt[i].id == id) { code = st->fmt[i].code; break; }
+    if (code == NULL || ! strcasecmp(code, "General")) return XK_NUMBER;
+    int date = 0, time = 0, quoted = 0, bracket = 0;
+    for (const char * c = code; *c; c++) {
+        if (*c == '\\' && c[1]) { c++; continue; }
+        if (*c == '"') { quoted = ! quoted; continue; }
+        if (quoted) continue;
+        if (*c == '[') { bracket = 1; continue; }
+        if (*c == ']') { bracket = 0; continue; }
+        if (bracket) continue;
+        if (*c == 'd' || *c == 'D' || *c == 'y' || *c == 'Y') date = 1;
+        if (*c == 'h' || *c == 'H' || *c == 's' || *c == 'S') time = 1;
+    }
+    return date && time ? XK_DATETIME : date ? XK_DATE : time ? XK_TIME : XK_NUMBER;
+}
