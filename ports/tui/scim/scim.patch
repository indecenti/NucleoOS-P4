+/* ---- the workbook: its sheets in order (names and part files) ----------------------------------- */
+
+typedef struct { char name[256]; char rid[64]; char sheet_id[32]; char target[256]; } xsheetref;
+typedef struct { xsheetref * v; int n, cap; } xsheets;
+
+static void wb_start(void * ud, const xmlChar * l, const xmlChar * p, const xmlChar * u, int nn,
+                     const xmlChar ** ns, int na, int nd, const xmlChar ** a) {
+    xsheets * s = ud;
+    if (strcmp((const char *) l, "sheet")) return;
+    if (s->n == s->cap) {
+        int cap = s->cap ? s->cap * 2 : 8;
+        xsheetref * v = realloc(s->v, sizeof(xsheetref) * cap);
+        if (v == NULL) return;
+        s->v = v;
+        s->cap = cap;
+    }
+    xsheetref * r = &s->v[s->n++];
+    memset(r, 0, sizeof(*r));
+    xattr(a, na, "name", r->name, sizeof(r->name));
+    xattr(a, na, "sheetId", r->sheet_id, sizeof(r->sheet_id));
+    xattr(a, na, "id", r->rid, sizeof(r->rid));               /* r:id */
+}
+
+static void rels_start(void * ud, const xmlChar * l, const xmlChar * p, const xmlChar * u, int nn,
+                       const xmlChar ** ns, int na, int nd, const xmlChar ** a) {
+    xsheets * s = ud;
+    char id[64], target[256];
+    if (strcmp((const char *) l, "Relationship")) return;
+    xattr(a, na, "Id", id, sizeof(id));
+    xattr(a, na, "Target", target, sizeof(target));
+    for (int i = 0; i < s->n; i++) {
+        if (strcmp(s->v[i].rid, id)) continue;
+        if (target[0] == '/') snprintf(s->v[i].target, sizeof(s->v[i].target), "%s", target + 1);
+        else snprintf(s->v[i].target, sizeof(s->v[i].target), "xl/%s", target);
+    }
 }
 
