+/* sc-im names for the common Excel functions in an imported formula */
+static void cell_formula(int r, int c, const char * text) {
+    wchar_t line_interp[FBUFLEN] = L"";
+    static const char * const fx[][2] = {
+        {"COUNT", "@COUNT"}, {"SUM", "@SUM"}, {"PRODUCT", "@PROD"}, {"AVERAGE", "@AVG"},
+        {"MIN", "@MIN"}, {"MAX", "@MAX"}, {"ABS", "@ABS"}, {"STDEV", "@STDDEV"},
+    };
+    char * formula = strdup(text);
+    if (formula == NULL) return;
+    uppercase(formula);
+    for (size_t i = 0; i < sizeof(fx) / sizeof(fx[0]); i++) {
+        char * strf = str_replace(formula, fx[i][0], fx[i][1]);
+        if (strf == NULL) break;
+        free(formula);
+        formula = strf;
+    }
+    swprintf(line_interp, FBUFLEN, L"let %s%d=%s", coltoa(c), r, formula);
+    send_to_interp(line_interp);
+    free(formula);
+}
