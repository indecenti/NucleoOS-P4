+static void sheet_start(void * ud, const xmlChar * l, const xmlChar * p, const xmlChar * u, int nn,
+                        const xmlChar ** ns, int na, int nd, const xmlChar ** a) {
+    xsheet * x = ud;
+    const char * name = (const char *) l;
+    char v[32];
+    if (! strcmp(name, "sheetData")) { x->in_data = 1; return; }
+    if (! x->in_data) return;
+    if (! strcmp(name, "row")) {
+        xattr(a, na, "r", v, sizeof(v));
+        x->row = v[0] ? atoi(v) : x->row + 1;
+        x->lastcol = -1;
+    } else if (! strcmp(name, "c")) {
+        x->in_c = 1;
+        xbuf_clear(&x->v);
+        xbuf_clear(&x->f);
+        xbuf_clear(&x->is);
+        x->fshared = 0;
+        xattr(a, na, "t", x->type, sizeof(x->type));
+        xattr(a, na, "s", v, sizeof(v));
+        x->style = v[0] ? atoi(v) : -1;
+        xattr(a, na, "r", v, sizeof(v));
+        int k = 0;
+        while (isalpha((unsigned char) v[k])) k++;
+        x->col = k ? atocol(v, k) : x->lastcol + 1;
+        if (v[k] && atoi(v + k) > 0) x->row = atoi(v + k);
+        x->lastcol = x->col;
+    } else if (x->in_c && ! strcmp(name, "v")) {
+        x->in_v = 1;
+    } else if (x->in_c && ! strcmp(name, "f")) {
+        x->in_f = 1;
+        xattr(a, na, "t", v, sizeof(v));
+        x->fshared = ! strcmp(v, "shared");                   /* shared formulas: their values */
+    } else if (x->in_c && ! strcmp(name, "is")) {
+        x->in_is = 1;
+    } else if (x->in_is && ! strcmp(name, "t")) {
+        x->in_t = 1;
+    }
+}
+static void sheet_end(void * ud, const xmlChar * l, const xmlChar * p, const xmlChar * u) {
+    xsheet * x = ud;
+    const char * name = (const char *) l;
+    if (! strcmp(name, "sheetData")) x->in_data = 0;
+    else if (! strcmp(name, "v")) x->in_v = 0;
+    else if (! strcmp(name, "f")) x->in_f = 0;
+    else if (! strcmp(name, "t")) x->in_t = 0;
+    else if (! strcmp(name, "is")) x->in_is = 0;
+    else if (! strcmp(name, "c") && x->in_c) { x->in_c = 0; cell_end(x); }
+}
+static void sheet_chars(void * ud, const xmlChar * ch, int len) {
+    xsheet * x = ud;
+    if (x->in_v) xbuf_add(&x->v, (const char *) ch, (size_t) len);
+    else if (x->in_f) xbuf_add(&x->f, (const char *) ch, (size_t) len);
+    else if (x->in_t) xbuf_add(&x->is, (const char *) ch, (size_t) len);
+}
