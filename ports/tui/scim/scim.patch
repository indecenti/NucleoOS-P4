+/* Every part streams out of the zip through these. */
+static int xzip_read(void * ctx, char * buf, int len) {
+    zip_int64_t n = zip_fread((zip_file_t *) ctx, buf, (zip_uint64_t) len);
+    return n < 0 ? -1 : (int) n;
+}
+static int xzip_close(void * ctx) { return zip_fclose((zip_file_t *) ctx); }
+
+/* SAX-parse one part. 1 = parsed, 0 = the part is not in the archive, -1 = malformed. */
+static int xlsx_sax(zip_t * za, const char * name, xmlSAXHandler * h, void * ud) {
+    zip_file_t * zf = zip_fopen(za, name, 0);
+    if (zf == NULL) return 0;
+    xmlParserCtxtPtr ctxt = xmlNewSAXParserCtxt(h, ud);
+    if (ctxt == NULL) { zip_fclose(zf); return -1; }
+    xmlDocPtr d = xmlCtxtReadIO(ctxt, xzip_read, xzip_close, zf, name, NULL, XML_PARSE_NONET | XML_PARSE_NOBLANKS);
+    int ok = ctxt->wellFormed;
+    if (d) xmlFreeDoc(d);
+    xmlFreeParserCtxt(ctxt);
+    return ok ? 1 : -1;
+}
