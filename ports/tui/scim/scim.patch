+/*
+ * NucleoOS: one lxw_format per distinct look, not one per cell. Upstream made a new format for
+ * every cell: 100,000 cells were 100,000 formats (tens of MB), and on a device with 16 MB for the
+ * program a big sheet could not be saved. The look is a small key; a sheet has few of them.
+ */
+struct xlsx_fmt_key {
+    int align;          /* LXW_ALIGN_*, 0 = none */
+    int style;          /* 1 bold, 2 italic, 3 underline, 0 none */
+    int fg, bg;         /* LXW_COLOR_*, -1 = none */
+    char num[64];       /* Excel number format ("" = none) */
+};
+struct xlsx_fmt {
+    struct xlsx_fmt_key k;
+    lxw_format * f;
+};
+#define XLSX_FMT_CACHE 256
+
+static int xlsx_color(int c) {
+    switch (c) {
+        case BLACK:   return LXW_COLOR_BLACK;
+        case RED:     return LXW_COLOR_RED;
+        case GREEN:   return LXW_COLOR_GREEN;
+        case YELLOW:  return LXW_COLOR_YELLOW;
+        case BLUE:    return LXW_COLOR_BLUE;
+        case MAGENTA: return LXW_COLOR_MAGENTA;
+        case CYAN:    return LXW_COLOR_CYAN;
+        case WHITE:   return LXW_COLOR_WHITE;
+    }
+    return -1;
+}
+
+static lxw_format * xlsx_format(lxw_workbook * wb, struct xlsx_fmt * cache, int * n,
+                                const struct xlsx_fmt_key * k) {
+    for (int i = 0; i < *n; i++)
+        if (! memcmp(&cache[i].k, k, sizeof(*k))) return cache[i].f;
+    lxw_format * f = workbook_add_format(wb);
+    if (k->align) format_set_align(f, k->align);
+    if (k->style == 1) format_set_bold(f);
+    else if (k->style == 2) format_set_italic(f);
+    else if (k->style == 3) format_set_underline(f, LXW_UNDERLINE_SINGLE);
+    if (k->fg >= 0) format_set_font_color(f, k->fg);
+    if (k->bg >= 0) format_set_bg_color(f, k->bg);
+    if (k->num[0]) format_set_num_format(f, k->num);
+    if (*n < XLSX_FMT_CACHE) {
+        cache[*n].k = *k;
+        cache[*n].f = f;
+        (*n)++;
+    }
+    return f;
+}
+
+/* A worksheet named after the sc-im sheet. Excel refuses []:*?/\ in a sheet name, an apostrophe
+ * at either end, more than 31 characters and a name used twice, and libxlsxwriter then returns
+ * NULL (upstream wrote into it and crashed): such a name is made valid instead. */
+static lxw_worksheet * xlsx_add_sheet(lxw_workbook * wb, const char * name) {
+    lxw_worksheet * ws = workbook_add_worksheet(wb, name);
+    if (ws != NULL || name == NULL) return ws;
+    char clean[32];
+    size_t k = 0;
+    for (const char * p = name; *p && k < sizeof(clean) - 1; p++)
+        clean[k++] = strchr("[]:*?/\\", *p) ? '_' : *p;
+    while (k && ((unsigned char) name[k] & 0xC0) == 0x80) k--;    /* no cut UTF-8 character */
+    clean[k] = '\0';
+    while (k && clean[k - 1] == '\'') clean[--k] = '\0';
+    char * c = clean;
+    while (*c == '\'') c++;
+    for (int i = 1; *c && i < 100; i++) {
+        char n[48];
+        if (i == 1) snprintf(n, sizeof(n), "%s", c);
+        else snprintf(n, sizeof(n), "%.24s (%d)", c, i);
+        if ((ws = workbook_add_worksheet(wb, n)) != NULL) return ws;
+    }
+    return workbook_add_worksheet(wb, NULL);   /* Sheet1, Sheet2... */
+}
