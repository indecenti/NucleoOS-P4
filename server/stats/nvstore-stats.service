# Destination: /etc/systemd/system/nvstore-stats.service
[Unit]
Description=Totals of the NucleoOS P4 app store install counter
After=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nvstore-stats

# Same caps as statistiche.service: this box has ~1 GB and runs the ExaWar lobby. A normal run
# is awk over a few kB; if the log ever explodes, this dies instead of the games.
MemoryMax=32M
MemorySwapMax=0
CPUQuota=20%
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=120

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/www/nucleoos/stats
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
