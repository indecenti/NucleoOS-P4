# Make GitHub's language bar reflect the FIRMWARE (C / C++), not the bundled web
# companion, generated tables or vendored assets. Scrapers and search filter by the
# detected language, so an ESP32/C project must read as C/C++, not JavaScript/HTML.
sd/web/**                     linguist-vendored
sd/nucleos/**                 linguist-vendored
sd/apps/**                    linguist-vendored
components/nv_ui/generated/**  linguist-generated
components/nv_fonts/**         linguist-generated
*.min.js                      linguist-vendored
*.565                         linguist-generated
*.gz                          linguist-vendored
# Built app modules and their sound assets: kept in-tree because the store export packages them
# from apps/<id>/; they are build outputs (sources next to them), never hand-edited or diffed.
apps/**/*.wasm                binary linguist-generated
apps/**/*.aot                 binary linguist-generated
sd/web/**/*.wasm              binary linguist-generated
*.wav                         binary

# Normalize line endings so the repo doesn't churn CRLF/LF across machines.
* text=auto
*.ps1 text eol=crlf
*.sh  text eol=lf
*.patch text eol=lf
# Embedded into the firmware byte for byte (the OTA release key): same bytes on every checkout.
*.pem text eol=lf
# tests/host runs under Linux/WSL make even from a Windows checkout: CRLF breaks Makefile recipes.
tests/host/**           text eol=lf
tests/host/corpus/**    binary
